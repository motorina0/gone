{
  "name": "gone-hello-world",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 5173",
    "typecheck": "grep -q '<h1>Hello world</h1>' index.html",
    "lint": "grep -q '<!doctype html>' index.html",
    "test": "grep -q '<main><h1>Hello world</h1></main>' index.html",
    "build": "rm -rf dist && mkdir dist && cp index.html dist/index.html"
  }
}
