{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 4
    },
    "observationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "observationRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "interactionRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "lockdownSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "description",
    "objectives",
    "observationSeconds",
    "observationRadius",
    "interactionRadius",
    "lockdownSeconds"
  ]
}
