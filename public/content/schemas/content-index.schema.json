{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "locations": {
      "type": "array",
      "minItems": 1
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "locations"
  ]
}
