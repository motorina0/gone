{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "exploration",
        "mission"
      ]
    },
    "world": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "navigation": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "minItems": 1
    },
    "patrols": {
      "type": "array",
      "minItems": 0
    },
    "projections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "views": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "occlusion": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "detailOverlays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "entityScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "mode",
    "world",
    "environment",
    "mission",
    "navigation",
    "entities",
    "patrols",
    "projections",
    "views",
    "occlusion",
    "detailOverlays",
    "entityScale"
  ]
}
