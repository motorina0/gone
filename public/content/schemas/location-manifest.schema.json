{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "exploration",
        "mission"
      ]
    },
    "world": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "navigation": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "minItems": 1
    },
    "patrols": {
      "type": "array",
      "minItems": 0
    },
    "projections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "views": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "backdrops": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "backdropScale": {"type": "number", "minimum": 1},
    "sourceViews": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "occlusion": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "detailOverlays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "depthMaps": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "defaultRendering": {"type": "string"},
    "renderings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "views": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 5,
            "maxItems": 5
          }
        },
        "required": ["id", "label", "views"]
      }
    },
    "highResolution": {
      "type": "object",
      "properties": {
        "stageWidth": {"type": "integer", "minimum": 1},
        "stageHeight": {"type": "integer", "minimum": 1},
        "tileSize": {"type": "integer", "minimum": 256},
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mimeType": {"const": "image/png"}
            },
            "required": ["path", "mimeType"],
            "additionalProperties": false
          }
        },
        "renderingIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "views": {"$ref": "#/$defs/highResolutionViews"},
        "detailOverlays": {"$ref": "#/$defs/highResolutionViews"},
        "occlusion": {"$ref": "#/$defs/highResolutionViews"}
      },
      "required": ["stageWidth", "stageHeight", "tileSize", "bundles", "renderingIds", "views", "detailOverlays", "occlusion"]
    },
    "preloadAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "required": ["path", "bytes"],
        "additionalProperties": false
      }
    },
    "agentAtlas": {"type": "string"},
    "agentCloseAtlases": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 8,
      "maxItems": 8
    },
    "agentCloseAnimation": {
      "type": "object",
      "properties": {
        "frameWidth": {"type": "integer", "minimum": 128},
        "frameHeight": {"type": "integer", "minimum": 160},
        "visibleHeightPixels": {"type": "integer", "minimum": 1},
        "firstVisibleRow": {"type": "integer", "minimum": 0},
        "lastVisibleRow": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1}
      },
      "required": ["frameWidth", "frameHeight", "visibleHeightPixels", "firstVisibleRow", "lastVisibleRow", "columns", "rows"]
    },
    "agentAnimation": {
      "type": "object",
      "properties": {
        "frameWidth": {"type": "integer", "minimum": 32},
        "frameHeight": {"type": "integer", "minimum": 32},
        "directions": {"const": 8},
        "visibleHeightPixels": {"type": "integer", "minimum": 1},
        "idle": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1},
        "walk": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2},
        "run": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2},
        "walkFrameRate": {"type": "number", "exclusiveMinimum": 0},
        "runFrameRate": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["frameWidth", "frameHeight", "directions", "idle", "walk", "run", "walkFrameRate", "runFrameRate"]
    },
    "entityScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "entityWorldHeightMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3
    }
  },
  "$defs": {
    "highResolutionViews": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "level": {"type": "integer", "minimum": 1, "maximum": 4},
                "sourceScale": {"type": "number", "minimum": 1},
                "tiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {"type": "number", "minimum": 0},
                      "y": {"type": "number", "minimum": 0},
                      "width": {"type": "number", "exclusiveMinimum": 0},
                      "height": {"type": "number", "exclusiveMinimum": 0},
                      "bundle": {"type": "integer", "minimum": 0},
                      "offset": {"type": "integer", "minimum": 0},
                      "bytes": {"type": "integer", "minimum": 1},
                      "cropX": {"type": "integer", "minimum": 0, "maximum": 1},
                      "cropY": {"type": "integer", "minimum": 0, "maximum": 1}
                    },
                    "required": ["x", "y", "width", "height", "bundle", "offset", "bytes", "cropX", "cropY"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["level", "sourceScale", "tiles"],
              "additionalProperties": false
            }
          }
        },
        "required": ["levels"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "mode",
    "world",
    "environment",
    "mission",
    "navigation",
    "entities",
    "patrols",
    "projections",
    "sourceViews",
    "views",
    "occlusion",
    "detailOverlays",
    "agentAtlas",
    "agentAnimation",
    "entityScale"
  ]
}
