{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "exploration",
        "mission"
      ]
    },
    "world": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "navigation": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "minItems": 1
    },
    "patrols": {
      "type": "array",
      "minItems": 0
    },
    "projections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "views": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "backdrops": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "backdropScale": {"type": "number", "minimum": 1},
    "sourceViews": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "occlusion": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "detailOverlays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "depthMaps": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 5,
      "maxItems": 5
    },
    "agentAtlas": {"type": "string"},
    "agentAnimation": {
      "type": "object",
      "properties": {
        "frameWidth": {"type": "integer", "minimum": 32},
        "frameHeight": {"type": "integer", "minimum": 32},
        "directions": {"const": 8},
        "idle": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1},
        "walk": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2},
        "run": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2},
        "walkFrameRate": {"type": "number", "exclusiveMinimum": 0},
        "runFrameRate": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["frameWidth", "frameHeight", "directions", "idle", "walk", "run", "walkFrameRate", "runFrameRate"]
    },
    "entityScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "mode",
    "world",
    "environment",
    "mission",
    "navigation",
    "entities",
    "patrols",
    "projections",
    "sourceViews",
    "views",
    "occlusion",
    "detailOverlays",
    "agentAtlas",
    "agentAnimation",
    "entityScale"
  ]
}
