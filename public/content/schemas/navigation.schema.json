{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "worldPoint": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "elevation": {"type": "number"}
      },
      "required": ["x", "y", "elevation"]
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "cellSize": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bounds": {
      "type": "object",
      "properties": {
        "minX": {"type": "number"},
        "minY": {"type": "number"},
        "maxX": {"type": "number"},
        "maxY": {"type": "number"}
      },
      "required": ["minX", "minY", "maxX", "maxY"]
    },
    "rectangles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "minElevation": {"type": "number"},
          "maxElevation": {"type": "number"}
        },
        "required": ["id", "x", "y", "width", "height"]
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "elevation": {"type": "number"},
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "x": {"type": "number"},
                "y": {"type": "number"},
                "elevation": {"type": "number"}
              },
              "required": ["x", "y", "elevation"]
            }
          },
          "elevationPlane": {
            "type": "object",
            "properties": {
              "originX": {"type": "number"},
              "originY": {"type": "number"},
              "originElevation": {"type": "number"},
              "slopeX": {"type": "number"},
              "slopeY": {"type": "number"}
            },
            "required": ["originX", "originY", "originElevation", "slopeX", "slopeY"]
          }
        },
        "required": ["id", "elevation", "points"]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["stairs", "ramp", "tunnel-portal", "crossing"]},
          "from": {"$ref": "#/$defs/worldPoint"},
          "to": {"$ref": "#/$defs/worldPoint"},
          "bidirectional": {"type": "boolean"}
        },
        "required": ["id", "type", "from", "to"]
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {"$ref": "#/$defs/worldPoint"}
          },
          "minElevation": {"type": "number"},
          "maxElevation": {"type": "number"}
        },
        "required": ["id", "points"]
      }
    }
  },
  "required": [
    "id",
    "schemaVersion"
  ],
  "anyOf": [
    {
      "required": [
        "rectangles"
      ]
    },
    {
      "required": [
        "areas"
      ]
    },
    {
      "required": [
        "cellSize",
        "bounds"
      ]
    }
  ]
}
