{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0}
  },
  "type": "object",
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "name": {"type": "string", "minLength": 1},
    "disclaimer": {"type": "string"},
    "atmosphere": {
      "type": "object",
      "properties": {
        "sky": {"$ref": "#/$defs/color"},
        "horizon": {"$ref": "#/$defs/color"},
        "ground": {"$ref": "#/$defs/color"},
        "groundDark": {"$ref": "#/$defs/color"},
        "backdropTexture": {"type": "string", "minLength": 1},
        "backdropTints": {
          "type": "array",
          "items": {"$ref": "#/$defs/color"},
          "minItems": 5,
          "maxItems": 5
        },
        "wetness": {"type": "number", "minimum": 0, "maximum": 1},
        "puddleCount": {"type": "integer", "minimum": 0, "maximum": 200},
        "leafLitterCount": {"type": "integer", "minimum": 0, "maximum": 500}
      },
      "required": ["sky", "horizon", "ground", "groundDark", "backdropTexture", "backdropTints", "wetness"]
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["road", "sidewalk", "plaza", "yard", "rail"]},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"$ref": "#/$defs/positiveNumber"},
          "height": {"$ref": "#/$defs/positiveNumber"},
          "color": {"$ref": "#/$defs/color"},
          "markings": {"enum": ["two-lane", "parking"]}
        },
        "required": ["id", "type", "x", "y", "width", "height"]
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"$ref": "#/$defs/positiveNumber"},
          "height": {"$ref": "#/$defs/positiveNumber"},
          "color": {"$ref": "#/$defs/color"},
          "elevation": {"type": "number", "minimum": 0},
          "roof": {"enum": ["flat", "pitched", "metal", "glass", "open"]},
          "material": {"enum": ["stone", "brick", "plaster", "concrete", "metal", "glass"]},
          "floors": {"type": "integer", "minimum": 1},
          "signText": {"type": "string", "minLength": 1, "maxLength": 48},
          "canopies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offset": {"type": "number", "minimum": 0},
                "length": {"$ref": "#/$defs/positiveNumber"},
                "depth": {"$ref": "#/$defs/positiveNumber"},
                "yOffset": {"type": "number"}
              },
              "required": ["offset", "length"]
            }
          },
          "renderInDetailOverlay": {"type": "boolean"},
          "occludes": {"type": "boolean"}
        },
        "required": ["id", "name", "type", "x", "y", "width", "height", "color"]
      }
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "elevation": {"type": "number"},
          "size": {"$ref": "#/$defs/positiveNumber"}
        },
        "required": ["x", "y"]
      }
    },
    "streetFurniture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "elevation": {"type": "number"},
          "rotation": {"type": "number"},
          "width": {"$ref": "#/$defs/positiveNumber"},
          "depth": {"$ref": "#/$defs/positiveNumber"},
          "height": {"$ref": "#/$defs/positiveNumber"},
          "color": {"$ref": "#/$defs/color"},
          "blocksMovement": {"type": "boolean"},
          "text": {"type": "string", "minLength": 1, "maxLength": 32},
          "castsLight": {"type": "boolean"},
          "energy": {"type": "number", "minimum": 0, "maximum": 1000}
        },
        "required": ["type", "x", "y"]
      }
    },
    "distantScenery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["building", "warehouse", "tree", "tank"]},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"$ref": "#/$defs/positiveNumber"},
          "height": {"$ref": "#/$defs/positiveNumber"},
          "elevation": {"type": "number", "minimum": 0},
          "size": {"$ref": "#/$defs/positiveNumber"},
          "rotation": {"type": "number"},
          "material": {"enum": ["brick", "plaster", "metal"]}
        },
        "required": ["id", "type", "x", "y"]
      }
    },
    "distantSurfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["road", "sidewalk", "plaza", "yard"]},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "width": {"$ref": "#/$defs/positiveNumber"},
          "height": {"$ref": "#/$defs/positiveNumber"},
          "color": {"$ref": "#/$defs/color"},
          "markings": {"enum": ["two-lane", "parking"]}
        },
        "required": ["id", "type", "x", "y", "width", "height"]
      }
    }
  },
  "required": ["id", "schemaVersion", "name", "atmosphere", "surfaces", "landmarks", "trees", "streetFurniture"]
}
